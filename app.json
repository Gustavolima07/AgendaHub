{
  "expo": {
    "name": "AgendaHub",
    "slug": "agendahub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "agendahub",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gustavolima07.agendahub"
    },
    "android": {
      "package": "com.gustavolima07.agendahub",
      "adaptiveIcon": {
        "backgroundColor": "#22634C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-sharing", "expo-notifications", "expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
