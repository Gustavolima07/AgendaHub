{
  "expo": {
    "name": "AgendaHub",
    "slug": "agendahub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "agendahub",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gustavolima07.agendahub"
    },
    "android": {
      "package": "com.gustavolima07.agendahub",
      "adaptiveIcon": {
        "backgroundColor": "#22634C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-sharing",
      "expo-notifications",
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "76125ad2-0bee-4dd2-b2a2-f94dab05108b"
      }
    },
    "owner": "luis_gustavo7",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/76125ad2-0bee-4dd2-b2a2-f94dab05108b"
    }
  }
}
